    {
      "name": "Google Gemini",
      "catalogue_author": "google",
      "api_type": "openai",
      "effort_levels": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "subscribe_url": "https://ai.google.dev",
      "default_model": "gemini-3.1-pro-preview",
      "models": [
        "gemini-3.1-pro-preview",
        "gemini-3.7-flash"
      ],
      "speech": {
        "stt": {
          "base": "https://generativelanguage.googleapis.com/v1beta",
          "path": "/models/{model}:generateContent",
          "encoding": "json",
          "auth": {
            "in": "header",
            "name": "x-goog-api-key"
          },
          "body": {
            "contents": [
              {
                "parts": [
                  {
                    "inlineData": {
                      "mimeType": "audio/wav",
                      "data": "{audio_base64}"
                    }
                  }
                ]
              }
            ],
            "generationConfig": {
              "audioTranscriptionConfig": {
                "languageCodes": [
                  "{language}"
                ]
              }
            }
          },
          "response": {
            "text": "$.candidates[0].content.parts[0].text"
          },
          "list_models": {
            "path": "/models",
            "query": {
              "pageSize": "1000"
            },
            "items": "$.models",
            "id": "$.name",
            "name": "$.displayName",
            "match": [
              "gemini"
            ],
            "skip": [
              "embedding",
              "imagen",
              "veo",
              "aqa",
              "tts",
              "live",
              "realtime",
              "native-audio"
            ],
            "trim": "models/"
          }
        }
      }
