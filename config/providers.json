          "body": {
            "text": "{text}",
            "model_id": "{model}"
          },
          "response": {
            "kind": "audio",
            "format": "pcm_s16le",
            "rate": 24000
          },
          "list_models": {
            "path": "/v1/models",
            "items": "$",
            "id": "$.model_id",
            "name": "$.name",
            "languages": "$.languages",
            "language_id": "$.language_id",
            "language_name": "$.name",
            "keep": "$.can_do_text_to_speech"
          },
          "list_voices": {
            "path": "/v2/voices",
            "query": {
              "page_size": "100"
            },
            "items": "$.voices",
            "id": "$.voice_id",
            "name": "$.name",
            "accent": "$.labels.accent",
            "gender": "$.labels.gender",
            "age": "$.labels.age",
            "languages": "$.verified_languages",
            "language_id": "$.language",
            "search": "search",
            "next": {
              "kind": "cursor",
              "param": "next_page_token",
              "at": "$.next_page_token",
              "more": "$.has_more"
            }
          }
        },
        "stt": {
          "path": "/v1/speech-to-text",
          "auth": {
            "in": "header",
            "name": "xi-api-key"
          },
          "fields": {
            "model_id": "{model}",
            "language_code": "{language}"
          },
          "list_models": {
            "spec": "https://api.elevenlabs.io/openapi.json",
            "items": "$.components.schemas.Body_Speech_to_Text_v1_speech_to_text_post.properties.model_id.examples",
            "id": "$"
          }
        }
      }
    },
