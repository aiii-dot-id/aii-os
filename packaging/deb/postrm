#!/bin/sh
set -e

# DELIBERATELY EMPTY of data removal: uninstall must not destroy
# explicitly retained identity and project data.
#
# An identity is a PQ-signed append-only ledger and its key. There is no
# second copy. `apt remove` removing ~/.aii would destroy identities
# permanently and silently, so this package never owns that directory
# and this script never touches it. Removing an identity is a
# deliberate, separate act by the person it belongs to:
#     rm -rf ~/.aii/identity-N
case "$1" in
  remove|purge)
    systemctl --global daemon-reload >/dev/null 2>&1 || true
    ;;
esac

exit 0
