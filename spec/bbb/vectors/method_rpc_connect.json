      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"error\":{\"code\":-32002,\"message\":\"authentication failed\"}}",
      "cite": "rpc.c:1265-1272"
    },
    {
      "name": "error_not_authenticated_before_connect",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"2\",\"error\":{\"code\":-32000,\"message\":\"not authenticated (call rpc.connect first)\"}}",
