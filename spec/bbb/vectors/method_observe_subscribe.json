{
  "suite": "method",
  "method": "observe.subscribe",
  "description": "Event subscription: subscription_id (< 40 bytes) + topic (< 96 bytes); capability-gated; per-connection table of 16; empty topic is wildcard, matching is exact or dot-segment prefix",
  "source": "the AII OS BBB conformance vectors",
  "checked_by": "framing round-trip now; subscription semantics land with the Go host RPC layer",
  "vectors": [
    {
      "name": "request",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"6\",\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":\"sub-1\",\"topic\":\"progress.\"}}",
      "note": "a topic ending in '.' prefix-matches; empty topic subscribes to everything",
      "cite": ""
    },
    {
      "name": "response_result",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"6\",\"result\":{\"accepted\":true,\"subscription_id\":\"sub-1\"}}",
      "cite": ""
    },
    {
      "name": "invalid_params_not_strings",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"6\",\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":6,\"topic\":\"progress.\"}}",
      "expect": { "code": -32602, "message": "subscription_id (string) and topic (string) required" },
      "cite": ""
    },
    {
      "name": "invalid_subscription_id_too_long",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"6\",\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":\"0123456789012345678901234567890123456789\",\"topic\":\"progress.\"}}",
      "expect": { "code": -32602, "message": "subscription_id or topic too long" },
      "note": "40 bytes is already too long: the bound is strictly-less-than the subscription-id bound (40); topics bound by 96 the same way; the C SDK pre-checks the same constants",
      "cite": ""
    },
    {
      "name": "invalid_duplicate_subscription_id",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"7\",\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":\"sub-1\",\"topic\":\"heartbeat.\"}}",
      "expect": { "code": -32600, "message": "subscription_id already active" },
      "note": "invalid only when sub-1 is already active on the connection",
      "cite": ""
    },
    {
      "name": "response_capability_not_negotiated",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"6\",\"error\":{\"code\":-32601,\"message\":\"UNSUPPORTED_CAPABILITY: observe.subscribe\"}}",
      "cite": ""
    }
  ]
}
