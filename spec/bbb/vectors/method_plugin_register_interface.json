{
  "suite": "method",
  "method": "plugin.register_interface",
  "description": "Registration must restate the signed manifest exactly: plugin_id, interface, capabilities[] (within the manifest envelope), operations[] each matching a manifest descriptor byte-for-byte; top-level description is ignored by the daemon",
  "source": "the AII OS BBB conformance vectors",
  "checked_by": "framing round-trip now; admission semantics land with the Go host plugin manager",
  "vectors": [
    {
      "name": "request_full",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"plugin.register_interface\",\"params\":{\"plugin_id\":\"com.aiii.web-evidence\",\"interface\":\"evidence.web@1\",\"description\":\"Fetch bounded web evidence.\",\"capabilities\":[\"net.outbound:example.com:443\"],\"operations\":[{\"operation_id\":\"web.fetch\",\"interface\":\"evidence.web@1\",\"method\":\"web.fetch\",\"description\":\"Fetch bounded web evidence.\",\"capability_tags\":[\"web\",\"evidence\"]}]}}",
      "note": "shape from the Go SDK's own registration test; every operation field must equal the signed manifest descriptor, capability_tags in count AND order",
      "cite": ""
    },
    {
      "name": "request_capability_free_sends_empty_array",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"plugin.register_interface\",\"params\":{\"plugin_id\":\"com.aiii.example.echo\",\"interface\":\"tool_bridge@1\",\"capabilities\":[],\"operations\":[{\"operation_id\":\"echo.call\",\"interface\":\"tool_bridge@1\",\"method\":\"echo.call\",\"description\":\"\",\"capability_tags\":[]}]}}",
      "note": "capabilities is wire-required; a missing or non-array field is PARAMS_INVALID; the Go SDK normalizes nil to []",
      "cite": ""
