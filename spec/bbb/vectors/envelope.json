{
  "suite": "envelope",
  "description": "JSON-RPC 2.0 envelope as BBB uses it: jsonrpc exactly \"2.0\"; requester-chosen id echoed verbatim; exactly one of result/error; notifications have no id and exist daemon-to-plugin only",
  "source": "the AII OS BBB conformance vectors",
  "checked_by": "framing round-trip now; envelope semantics land with the RPC layer",
  "vectors": [
    {
      "name": "request_string_id",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":\"sub-1\",\"topic\":\"progress.\"}}",
      "cite": "C SDK id form"
    },
    {
      "name": "request_numeric_id",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"observe.subscribe\",\"params\":{\"subscription_id\":\"sub-1\",\"topic\":\"progress.\"}}",
      "cite": "Go SDK id form; receivers accept both"
    },
    {
      "name": "request_daemon_to_plugin_string_id",
      "kind": "request",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"svc-1\",\"method\":\"plugin.invoke\",\"params\":{\"operation_id\":\"echo.call\",\"interface\":\"tool_bridge@1\",\"method\":\"echo.call\",\"arguments\":{}}}",
      "cite": "AddStringToObject id"
    },
    {
      "name": "response_result_echoes_string_id",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"accepted\":true,\"subscription_id\":\"sub-1\"}}",
      "cite": "verbatim id echo"
    },
    {
      "name": "response_result_echoes_numeric_id",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"accepted\":true,\"subscription_id\":\"sub-1\"}}",
      "cite": ""
    },
    {
      "name": "response_error_plain",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32601,\"message\":\"method not found\"}}",
      "cite": "exact example frame"
    },
    {
      "name": "response_error_with_reason_data",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"3\",\"error\":{\"code\":-32000,\"message\":\"Capability scope does not admit the requested operation\",\"data\":{\"reasonCode\":\"OPERATION_SCOPE_MISMATCH\",\"denied_at\":\"capability\"}}}",
      "cite": "(camelCase reasonCode, optional denied_at); denial code -32000"
    },
    {
      "name": "response_parse_error_id_null",
      "kind": "response",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"JSON parse error\"}}",
      "cite": ""
    },
    {
      "name": "notification_no_id",
      "kind": "notification",
      "direction": "daemon_to_plugin",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"method\":\"observe.event\",\"params\":{\"topic\":\"progress.step\",\"payload\":{\"pct\":50}}}",
      "cite": "id must be ABSENT"
    },
    {
      "name": "invalid_wrong_jsonrpc_version",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"1.0\",\"id\":\"1\",\"method\":\"rpc.cancel\",\"params\":{\"work_done_token\":\"wdt-1\"}}",
      "expect": { "code": -32600, "message": "invalid JSON-RPC 2.0 request" },
      "cite": ""
    },
    {
      "name": "invalid_missing_jsonrpc",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"id\":\"1\",\"method\":\"rpc.cancel\",\"params\":{\"work_done_token\":\"wdt-1\"}}",
      "expect": { "code": -32600, "message": "invalid JSON-RPC 2.0 request" },
      "cite": ""
    },
    {
      "name": "invalid_method_not_a_string",
      "kind": "invalid",
      "direction": "plugin_to_daemon",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":42,\"params\":{}}",
      "expect": { "code": -32600, "message": "invalid JSON-RPC 2.0 request" },
      "cite": ""
    },
    {
      "name": "invalid_response_with_both_result_and_error",
      "kind": "invalid",
      "direction": "daemon_to_plugin",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{},\"error\":{\"code\":-32603,\"message\":\"x\"}}",
      "cite": "exactly one of result/error"
    },
    {
      "name": "invalid_response_with_neither_result_nor_error",
      "kind": "invalid",
      "direction": "daemon_to_plugin",
      "judgement": "invalid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":\"1\"}",
      "cite": ""
    },
    {
      "name": "request_without_id_is_answered_with_null_id",
      "kind": "request",
      "direction": "plugin_to_daemon",
      "judgement": "valid",
      "payload_utf8": "{\"jsonrpc\":\"2.0\",\"method\":\"rpc.cancel\",\"params\":{\"work_done_token\":\"wdt-1\"}}",
      "note": "NOT a notification: the daemon runs the handler and replies with id null; plugin-side C dispatch rejects id-less requests without replying",
      "cite": ""
    }
  ]
}
