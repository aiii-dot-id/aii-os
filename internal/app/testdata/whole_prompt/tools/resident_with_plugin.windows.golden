=== tool 15 of 15: tools ===
Discovery: your organs and sandbox tools; and the plugin operations installed beside you, the primary ones in your tool list and any other run with action=call.
--- parameters ---
{
  "properties": {
    "action": {
      "description": "organs (default: organs, sandbox tools and the plugin brief), brief (plugin operations by family), search (query: by need), show (name: one operation's arguments, receipt rule and release), call (name, args)",
      "type": "string"
    },
    "args": {
      "description": "(call) the operation's arguments, as tools action=show gives them",
      "type": "object"
    },
    "depth": {
      "description": "1 = names, 2 = with descriptions, 3 = full detail",
      "type": "integer"
    },
    "name": {
      "description": "(show, call) the operation id as your prompt or the brief names it, or its tool name",
      "type": "string"
    },
    "query": {
      "description": "(search) what you need, in your own words",
      "type": "string"
    }
  },
  "type": "object"
}
