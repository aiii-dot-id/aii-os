   "b": "0.1.9",
   "cmp": 1
  },
  {
   "name": "major outranks everything after it",
   "a": "1.0.0",
   "b": "0.99.99",
   "cmp": 1
  },
  {
   "name": "leading zeros normalize",
   "a": "00.01.006",
   "b": "0.1.6",
   "cmp": 0
  },
  {
   "name": "components compare as numbers, not text",
   "a": "0.1.10",
   "b": "0.1.9",
   "cmp": 1
  },
  {
   "name": "a component too large for an integer still ranks above",
   "a": "999999999999999999999999999999999999.0.0",
   "b": "1.0.0",
   "cmp": 1
  },
  {
   "name": "and below from the other side",
