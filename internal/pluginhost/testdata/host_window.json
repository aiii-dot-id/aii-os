{
 "_": "Host-window vectors, shared byte for byte between the host (internal/packagefmt, internal/pluginhost) and the kit (pkg/aiiospkg). The grammar is the canonical manifest schema's aiios_semver_core: three decimal numbers, major.minor.patch, leading zeros permitted, no prerelease and no build metadata; components compare as numbers of any size. Sections: grammar (both sides validate the pair), order (both sides compare), presence (the host READER judges bounds as written — null, empty and mistyped are malformed, never absent; the kit WRITER must never emit such a form), ranking (the host judges its own version against a window; a host version outside the grammar cannot be ranked and refuses a bounded package).",
 "grammar": [
  {
   "name": "no window at all runs anywhere",
   "min": "",
   "max": "",
   "ok": true
  },
  {
   "name": "a minimum alone",
   "min": "0.1.7",
   "max": "",
   "ok": true
  },
  {
   "name": "a maximum alone",
   "min": "",
   "max": "0.3.0",
   "ok": true
  },
  {
   "name": "a window with versions in it",
   "min": "0.1.7",
   "max": "0.3.0",
   "ok": true
  },
  {
   "name": "leading zeros are part of this grammar",
   "min": "00.01.006",
   "max": "00.02.000",
   "ok": true
  },
  {
   "name": "a leading zero in one component",
   "min": "01.2.3",
   "max": "",
   "ok": true
  },
  {
   "name": "a core too large for an integer still ranks",
   "min": "999999999999999999999999999999999999.0.0",
   "max": "1.0.0",
   "ok": false,
   "refuses_naming": "empty"
  },
  {
   "name": "and ranks the other way round too",
   "min": "1.0.0",
   "max": "999999999999999999999999999999999999.0.0",
   "ok": true
  },
  {
   "name": "a window with no versions in it",
   "min": "0.3.0",
   "max": "0.3.0",
   "ok": false,
   "refuses_naming": "empty"
  },
  {
   "name": "a window that runs backwards",
   "min": "0.4.0",
   "max": "0.2.0",
   "ok": false,
   "refuses_naming": "empty"
  },
  {
   "name": "equal once leading zeros are normalized is still empty",
   "min": "1.2.3",
   "max": "01.02.003",
   "ok": false,
   "refuses_naming": "empty"
  },
  {
   "name": "a prerelease is not this grammar",
   "min": "1.0.0-beta.1",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "build metadata is not this grammar",
   "min": "1.0.0+build.5",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "a prerelease maximum is named as the maximum",
   "min": "",
   "max": "1.0.0-alpha",
   "ok": false,
   "refuses_naming": "aiios_max_exclusive_version"
  },
  {
   "name": "a two-part core is not a version",
   "min": "0.2",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "a four-part core is not a version",
   "min": "1.2.3.4",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "words are not a version",
   "min": "one.two.three",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "a leading v is not this grammar",
   "min": "v1.2.3",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "a trailing hyphen mark",
   "min": "1.2.3-",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "surrounding space",
   "min": " 1.2.3",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "a sign",
   "min": "+1.2.3",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
   "name": "an empty component",
   "min": "1..3",
   "max": "",
   "ok": false,
   "refuses_naming": "aiios_min_version"
  },
  {
